# Copy this file to ".env" (same folder) and fill in your values, then run run_live.bat.
# ---------------------------------------------------------------------------------------

# Your German postal code (used as the default region).
DEFAULT_PLZ=80331

# Turn OFF demo mode to use real Marktguru data (leave unset or 0).
DEMO_MODE=0

# Marktguru API keys.
# The app will TRY to fetch these automatically from marktguru.de on first use, so you may
# not need them. If a refresh returns 0 offers, capture them from your browser (see
# docs/live-marktguru-setup.md) and paste them here:
# MARKTGURU_CLIENT_KEY=paste-x-clientkey-here
# MARKTGURU_API_KEY=paste-x-apikey-here
